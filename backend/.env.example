# NextStep Talent backend environment
# Copy this file to `.env` and replace placeholder values for your environment.
# Never commit real `.env` files or production secrets.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# The frontend example points to http://localhost:5001/api.
PORT=5001

# Set to true when Express runs behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Required. Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/nexttalent

# Optional fallback alias supported by the app. Leave blank when MONGO_URI is set.
MONGODB_URI=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Required. Use a long random value, preferably 32+ characters.
JWT_SECRET=replace-with-a-long-random-jwt-secret

# -----------------------------------------------------------------------------
# Frontend and public URLs
# -----------------------------------------------------------------------------
# Used for redirects, CTA links, email links, and generated PDFs.
FRONTEND_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Public website URL for email/PDF footers. Usually the production frontend URL.
WEBSITE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Admin access
# -----------------------------------------------------------------------------
# Simple single-admin setup. The admin is read from env and is not stored in Mongo.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Platform Admin

# Optional JSON array for multiple admins. Roles: super_admin, payments_admin,
# evaluation_admin, operations_admin.
ADMIN_USERS=
# ADMIN_USERS=[{"email":"super.admin@example.com","password":"replace-with-a-strong-password","name":"Super Admin","role":"super_admin"}]

# Optional role-specific admin setup. If any of these email/password pairs are set,
# they take precedence over ADMIN_USERS and the single ADMIN_* account above.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

PAYMENT_ADMIN_EMAIL=
PAYMENT_ADMIN_PASSWORD=
PAYMENT_ADMIN_NAME=

EVALUATION_ADMIN_EMAIL=
EVALUATION_ADMIN_PASSWORD=
EVALUATION_ADMIN_NAME=

OPERATIONS_ADMIN_EMAIL=
OPERATIONS_ADMIN_PASSWORD=
OPERATIONS_ADMIN_NAME=

# Extra notification recipient alias used by payment-admin email routing.
PAYMENTS_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# Required for sending transactional emails. Leave blank in local development if
# you do not need outbound email; non-strict mode suppresses delivery failures.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Defaults are provided in code when these are blank.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NextStep Talent

# Use SSL for port 465. STARTTLS is common for port 587.
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# Optional sender overrides for workflow emails.
NOREPLY_FROM_EMAIL=
TEAM_FROM_EMAIL=

# In strict mode, email delivery errors are thrown instead of suppressed.
EMAIL_STRICT_MODE=false
EMAIL_LOG_ERRORS=false

# -----------------------------------------------------------------------------
# Stripe payments
# -----------------------------------------------------------------------------
# Required only for live Stripe checkout/payment endpoints.
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key

# Stripe webhook signing secret. STRIPE_ENDPOINT_SECRET is accepted as a fallback.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_ENDPOINT_SECRET=

# -----------------------------------------------------------------------------
# Branding and PDFs
# -----------------------------------------------------------------------------
# Optional logo overrides. When blank, the app uses frontend/public/logo.png.
BRAND_LOGO_URL=
BRAND_LOGO_PATH=
COMPANY_LOGO_PATH=

# Optional company address override for invoices/receipts. Use \n inside quotes
# if you need multiple lines, for example: "Line 1\nCity, ST 12345\nCountry".
COMPANY_OFFICE_ADDRESS=

# Optional fixed invoice numbers. Leave blank to auto-generate unique numbers.
STAGE1_INVOICE_NUMBER=
STAGE2_INVOICE_NUMBER=

# -----------------------------------------------------------------------------
# Audit and retention
# -----------------------------------------------------------------------------
# Number of years of audit logs to include before retention cutoff.
AUDIT_RETENTION_YEARS=7

# -----------------------------------------------------------------------------
# Sterling background checks
# -----------------------------------------------------------------------------
# true keeps local/dev flows working without real Sterling credentials.
STERLING_MOCK_MODE=true

# Required only when STERLING_MOCK_MODE=false.
STERLING_API_BASE_URL=
STERLING_API_KEY=
STERLING_CLIENT_ID=
STERLING_CLIENT_SECRET=
