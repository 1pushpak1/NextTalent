MONGO_URI=mongodb://127.0.0.1:27017/nextstep-talent
JWT_SECRET=replace_with_secure_secret
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
EMAIL_USER=placeholder@example.com
EMAIL_PASS=placeholder_password
PORT=5001
FRONTEND_URL=http://localhost:5173
WEBSITE_URL=https://nextsteptalent.net
COMPANY_LOGO_PATH=../frontend/public/logo.png
COMPANY_OFFICE_ADDRESS=8735 Dunwoody Place Ste N, Atlanta, GA 30350, United States

# SMTP (required for outbound emails)
SMTP_HOST=mail.ravviolabs.com
SMTP_PORT=587
SMTP_USERNAME=info@mail.ravviolabs.com
SMTP_PASSWORD=replace_with_real_smtp_password
SMTP_FROM_EMAIL=info@mail.ravviolabs.com
SMTP_FROM_NAME=NextStep Talent
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_LOG_ERRORS=false
EMAIL_STRICT_MODE=false

# Sterling background check integration
STERLING_API_BASE_URL=
STERLING_API_KEY=
STERLING_CLIENT_ID=
STERLING_CLIENT_SECRET=
STERLING_PACKAGE_CODE=professional
STERLING_MOCK_MODE=true

# Optional workflow/admin sender overrides.
# Keep these aligned with SMTP_FROM_EMAIL unless you have verified domain auth for alternatives.
NOREPLY_FROM_EMAIL=info@mail.ravviolabs.com
TEAM_FROM_EMAIL=info@mail.ravviolabs.com
# Role-based admin accounts (preferred)
# super_admin: full access across all admin actions and management
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=password
SUPER_ADMIN_NAME=Super Admin

# payment_admin: full access (same as super_admin for now), owns payment approvals
PAYMENT_ADMIN_EMAIL=payments@example.com
PAYMENT_ADMIN_PASSWORD=password
PAYMENT_ADMIN_NAME=Payments Admin

# evaluation_admin: can approve evaluation/document verification, cannot approve payments
EVALUATION_ADMIN_EMAIL=evaluation@example.com
EVALUATION_ADMIN_PASSWORD=password
EVALUATION_ADMIN_NAME=Evaluation Admin

# operations_admin: operational workflow access, cannot approve evaluation/documents/payments
OPERATIONS_ADMIN_EMAIL=operations@example.com
OPERATIONS_ADMIN_PASSWORD=password
OPERATIONS_ADMIN_NAME=Operations Admin

# Optional backward-compatible JSON fallback (not preferred)
# ADMIN_USERS=[{"email":"super@example.com","password":"change_super_password","role":"super_admin","name":"Super Admin"}]

# Legacy single-admin fallback (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_NAME=Platform Admin
